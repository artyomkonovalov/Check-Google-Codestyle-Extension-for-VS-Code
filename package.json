{
  "name": "google-cpp-style-checker",
  "displayName": "Google C++ Style Checker",
  "description": "Check C++ code for Google Style Guide compliance",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onCommand:checkcodestyle"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "checkcodestyle",
        "title": "Check Google Code Style"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^14.18.63",
    "@types/vscode": "^1.106.1",
    "typescript": "^4.9.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artyomkonovalov/Check-Google-Codestyle-Extension-for-VS-Code.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/artyomkonovalov/Check-Google-Codestyle-Extension-for-VS-Code/issues"
  },
  "homepage": "https://github.com/artyomkonovalov/Check-Google-Codestyle-Extension-for-VS-Code#readme"
}
